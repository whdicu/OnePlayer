	color: #5c5c66;
	background-color: transparent;
}

#btn_widget
{
	background-color: #ffffff;
	border-top-left-radius: 20px;
	border-top-right-radius: 20px;
}

#btn_widget QPushButton
{
	color: #5c5c66;
	background-color: transparent;
	border: none;
}
#btn_widget QPushButton:hover
{
	background-color: rgba(182, 209, 200, 0.5);
	border: none;
	border-top-left-radius: 20px;
	border-top-right-radius: 20px;
}

 
#stacked_widget
{
