  <property name="styleSheet">
   <string notr="true">#widget_top {
	background-color: transparent;
}

#widget_radius1 {
	background: radial-gradient(circle at bottom right, transparent 0px, transparent 40px, blue 40px);
}

#Widget {
	background-color: white;
}

QPushButton {
	background-color: rgb(255, 255, 255);
}

QPushButton:hover {
	background-color: rgba(255, 255, 255, 0.75);
}

QLabel {
	color: #5c5c66;
}

#music,
#setting,
#p,
#page_netease {
	background-color: white;
	border: 1px solid #5c5c66;
	border-top-left-radius: 40px;
	border-top-right-radius: 40px;
}

#stacked_info {
	border-radius: 20px;
}

#label_image {
	border-radius: 20px;
}


#scrollArea {
	background-color: white;
	border: none;
}

#music_area {
	background-color: white;
	padding: 0px;
}

#scrollArea_online {
	background-color: white;
	border: none;
}

#music_area_online {
	background-color: white;
	padding: 0px;
}

#widget_btn {
	background-color: rgb(182, 209, 200);
	border: 1px solid #5c5c66;
	border-bottom-left-radius: 40px;
	border-bottom-right-radius: 40px;
}

#widget_btn QPushButton {
	border-radius: 20px;
}

/* 进度条 */
#progress {
	background-color: white;
	border-radius: 6px;
}

/*2.未滑动过的槽设计参数*/
#progress::add-page:horizontal {
	height: 12px;
	background: white;
	border-radius: 4px;
	margin-top: 2px;
	margin-bottom: 2px;
	margin-left: 0px;
	margin-right: 2px;
}

/*1.滑动过的槽设计参数*/
#progress::sub-page:horizontal {
	height: 12px;
	background: #5c5c66;
	border-radius: 4px;
	margin-top: 2px;
	margin-bottom: 2px;
	margin-left: 2px;
}

/*滑块设置*/
#progress::handle:horizontal {
	background: #b6d1c8;
	width: 12px;
	border-radius: 5px; 
}

/*歌曲名按钮*/
#btn_music_name
{
	color: #5c5c66;
	background-color: transparent;
}

#label_dir {
	color: #5c5c66;
}

#setting&gt;QPushButton,
#btn_search {
	color: #5c5c66;
	background-color: #b6d1c8;
	border-radius: 15px;
}

#widget {
	border-radius: 10px;
	background-color: white;
}

/*#le_search {
	border: 2px solid #5c5c66;
	border-radius: 15px;
	color: #5c5c66;
	padding-left: 5px;
}*/

#label_mask
{
	border: 3px dashed #5c5c66;
	border-radius: 20px;
}

</string>
