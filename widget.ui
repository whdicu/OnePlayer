  <property name="styleSheet">
   <string notr="true">#widget_radius1 {
	background: radial-gradient(circle at bottom right, transparent 0px, transparent 40px, blue 40px);
}

#Widget {
	background-color: white;
}

QPushButton {
	background-color: rgb(255, 255, 255);
}

QPushButton:hover {
	background-color: rgba(255, 255, 255, 0.75);
}

QLabel {
	color: #5c5c66;
}

#music,
#setting,
#p {
	background-color: white;
	border: 1px solid #5c5c66;
	border-top-left-radius: 40px;
	border-top-right-radius: 40px;
}

#stacked_info {
	border-radius: 20px;
}

#label_image {
	border-radius: 20px;
}





#scrollArea {
	background-color: white;
	border: none;
}

#music_area {
	background-color: white;
	padding: 0px;
}

#scrollArea QPushButton {
	color: #5c5c66;
	background-color: rgba(182, 209, 200, 0.25);
	border-radius: 15px;
	padding-left: 10px;
}

#scrollArea QPushButton:hover {
	background-color: rgba(182, 209, 200, 0.5);
}

#widget_btn {
	background-color: rgb(182, 209, 200);
	border: 1px solid #5c5c66;
	border-bottom-left-radius: 40px;
	border-bottom-right-radius: 40px;
}

#widget_btn QPushButton {
	border-radius: 20px;
}

/* 进度条 */
#progress {
	background-color: white;
	border-radius: 6px;
}

/*2.未滑动过的槽设计参数*/
#progress::add-page:horizontal {
	height: 12px;
	background: white;
	border-radius: 4px;
	margin-top: 2px;
	margin-bottom: 2px;
	margin-left: 0px;
	margin-right: 2px;
}

/*1.滑动过的槽设计参数*/
#progress::sub-page:horizontal {
	height: 12px;
	background: #5c5c66;
	border-radius: 4px;
	margin-top: 2px;
	margin-bottom: 2px;
	margin-left: 2px;
}

/*滑块设置*/
#progress::handle:horizontal {
	background: #b6d1c8;
	width: 12px;
	border-radius: 5px; 
}

/*歌曲名按钮*/
#btn_music_name {
	color: #5c5c66;
	background-color: rgb(182, 209, 200);
}

#label_dir {
	color: #5c5c66;
}

#btn_change_dir {
	color: #5c5c66;
	background-color: #b6d1c8;
	border-radius: 10px;
}

/* 搜索播放列表的左右按钮 */
#find_btn_widget {
	border-radius: 15px;
	background-color: #5c5c66;
}

#btn_left {
	background-color: rgb(182, 209, 200);
	border-top-left-radius: 10px;
	border-bottom-left-radius: 10px;
}

#btn_right {
	background-color: rgb(182, 209, 200);
	border-top-right-radius: 10px;
	border-bottom-right-radius: 10px;
}

#widget {
	border-radius: 10px;
	background-color: white;
}

#le_find {
	border: none;
	border-radius: 10px;
	color: #5c5c66;
}

#label_mask {
	background-color: white;
	border: 3px dashed #5c5c66;
	border-radius: 20px;
}</string>
